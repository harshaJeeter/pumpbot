[Unit]
Description=Pump.fun Trading Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pumpbot
EnvironmentFile=/root/pumpbot/.env
ExecStart=/root/pumpbot/venv/bin/python3 /root/pumpbot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
