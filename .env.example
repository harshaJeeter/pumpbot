# Pump.fun Trading Bot - Environment Variables
# Copy this to .env and fill in your values

# ═══ WALLET ═══
# Your wallet private key (base58 encoded OR JSON byte array)
WALLET_PRIVATE_KEY=your_base58_private_key_here
WALLET_PUBLIC_KEY=2aWA3rTGesJu7bZVtepRrM4oAgVP4vQvfW7Qs5nWpycM

# ═══ RPC ═══
# Helius RPC (recommended for speed and DAS API)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=YOUR_HELIUS_KEY

# ═══ TELEGRAM ═══
# Get bot token from @BotFather, chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ DATA ═══
DATA_DIR=./data
